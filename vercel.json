{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/public/favicon.ico" },
    { "source": "/robots.txt", "destination": "/public/robots.txt" },
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/docs/(.*)", "destination": "/public/docs/$1" },
    { "source": "/uploads/(.*)", "destination": "/public/uploads/$1" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ]
}
