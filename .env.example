#--------------------------------------------------------------------
# PIA-AFMS — Production Environment Reference
#--------------------------------------------------------------------
# Local development: copy this file to `.env` and adjust the values.
#--------------------------------------------------------------------

# Must be `production` on the server (disables debug pages & debugbar)
CI_ENVIRONMENT = production

# Public URL of the deployment (trailing slash required)
app.baseURL = 'https://your-project.vercel.app/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = false

#--------------------------------------------------------------------
# Database Configuration
#--------------------------------------------------------------------
database.default.hostname = 'db.example.com'
database.default.database = 'fleet_db'
database.default.username = 'fleet_user'
database.default.password = 'change-me'
database.default.DBDriver = 'MySQLi'
database.default.DBPrefix = ''
database.default.port = 3306
database.default.charset = 'utf8mb4'
database.default.DBCollat = 'utf8mb4_general_ci'

#--------------------------------------------------------------------
# Sessions
#--------------------------------------------------------------------
session.driver = CodeIgniter\Session\Handlers\DatabaseHandler
session.savePath = sessions

logger.threshold = warning

# 32-byte base64 key — generate once and keep it stable per environment:
#   php spark key:generate -k
encryption.key = 'generate-a-stable-random-key'

#--------------------------------------------------------------------
# Mapping, Routing & Telematics API Configuration
#--------------------------------------------------------------------
# Keyless OpenStreetMap + OSRM + Nominatim is active by default.
# Leaving GOOGLE_MAPS_API_KEY or ORS_API_KEY blank will NEVER cause errors;
# RouteService automatically falls back to OSRM and the PIA Gazetteer.
OSRM_URL = 'https://router.project-osrm.org/route/v1/driving/'
NOMINATIM_URL = 'https://nominatim.openstreetmap.org/search'
GOOGLE_MAPS_API_KEY = ''
ORS_API_KEY = ''
TELEMATICS_API_KEY = ''

#--------------------------------------------------------------------
# Email — SMTP when available; otherwise messages queue in the
# email_outbox table and surface as in-app notifications.
#--------------------------------------------------------------------
# email.protocol = smtp
# email.fromEmail = no-reply@pia.gov.ph
# email.fromName = 'PIA Motorpool'
# email.SMTPHost = smtp.example.com
# email.SMTPPort = 587
