#-------------------------
# Operating Specific Junk Files
#-------------------------

# OS X
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

#-------------------------
# Environment Files
#-------------------------
# Never commit actual credentials; keep only the example template
.env
.env.*
!.env.example
.vagrant
Vagrantfile

#-------------------------
# Runtime & Temporary Files
#-------------------------
/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

/public/uploads/*
php_errors.log

#-------------------------
# Test & Build Artifacts
#-------------------------
/tests/coverage*
/tests/cookie*.txt
/public/docs/
/phpunit
/build/
/results/
/phpunit.xml

#-------------------------
# Composer
#-------------------------
vendor/

#-------------------------
# IDE / Deployment Files
#-------------------------
_modules/*
.php-version
.idea/
*.iml
/nbproject/
/nbbuild/
/dist/
/nbdist/
/nbactions.xml
/nb-configuration.xml
/.nb-gradle/
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
.phpintel
.vscode/
.vercel
